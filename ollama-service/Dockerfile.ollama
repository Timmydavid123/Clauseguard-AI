FROM ollama/ollama:latest

EXPOSE 11434

# Copy scripts
COPY ollama-service/start.ollama.sh /start.ollama.sh
COPY ollama-service/pull-model.sh /pull-model.sh

RUN chmod +x /start.ollama.sh /pull-model.sh

ENV OLLAMA_HOST=0.0.0.0:11434
ENV OLLAMA_MODEL=qwen2.5:3b-instruct

# Override the entrypoint to use shell
ENTRYPOINT ["/bin/bash"]
CMD ["/start.ollama.sh"]