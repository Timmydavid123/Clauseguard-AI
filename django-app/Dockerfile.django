FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libmagic1 \
    libglib2.0-0 \
    libgl1 \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements from django-app folder
COPY django-app/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the entire django-app contents to /app
COPY django-app/ .

# Make sure start script is executable
COPY django-app/start.django.sh /start.sh
RUN chmod +x /start.sh

# Debug: List files to verify
RUN echo "Files in /app:" && ls -la /app
RUN echo "Clauseguard directory:" && ls -la /app/clauseguard

CMD ["/start.sh"]